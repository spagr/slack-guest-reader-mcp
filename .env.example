# Copy to .env for local runs. Placeholders only; never commit a real .env.
# On Cloud Run the three secrets come from Secret Manager (see scripts/deploy.sh).

# --- Slack (from the workspace admin, via a secure channel) ---
SLACK_BOT_TOKEN=xoxb-REPLACE-ME
# Needed only for the /slack/events receiver (phase 2). Leave unset to disable it.
#SLACK_SIGNING_SECRET=replace-me
SLACK_CHANNEL_ALLOWLIST=C0000000000,G0000000000
ME_USER_ID=U0000000000

# --- Google OAuth (MCP side) ---
GOOGLE_CLIENT_ID=000000000000-replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE-ME
ALLOWED_EMAILS=you@example.com
# Cloud Run URL or custom domain; http://localhost:8080 for local runs.
PUBLIC_BASE_URL=https://my-service-000000000000.europe-west1.run.app
# Optional: explicit keys instead of deriving both from GOOGLE_CLIENT_SECRET.
#JWT_SIGNING_KEY=
#STORAGE_ENCRYPTION_KEY=

# --- Storage ---
# false = in-memory store (local dev only; logs everyone out on restart).
FIRESTORE_ENABLED=false
#FIRESTORE_DATABASE=(default)
#GOOGLE_CLOUD_PROJECT=my-gcp-project

# --- Behaviour ---
TIMEZONE=UTC
THREAD_LOOKBACK_DAYS=14
NOTIFY_THREAD_ACTIVITY=true
NOTIFY_GROUP_MENTIONS=false
EVENTS_TTL_DAYS=30
# After this many hours without any Slack event, get_notifications polls as well (0 = always)
EVENTS_STALE_HOURS=6
#ALERT_WEBHOOK_URL=https://example.com/hook
# Optional error reporting; leave unset to disable. Never logs message text.
#SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
#SENTRY_ENVIRONMENT=production
LOG_LEVEL=INFO
PORT=8080
